From ce91f32f4358de0c40b93ff8c9804715ca205baa Mon Sep 17 00:00:00 2001
From: osbal <abdulsaepul93@gmail.com>
Date: Tue, 20 Oct 2026 12:24:31 +0000
Subject: [PATCH] Implement Message copying for AppCompat dialog button actions

---
 .../src/android/os/Message.java               | 16 ++++++-
 tests/java-framework/MessageCopyTest.java     | 43 +++++++++++++++++++
 2 files changed, 58 insertions(+), 1 deletion(-)
 create mode 100644 tests/java-framework/MessageCopyTest.java

diff --git a/src/java-framework/src/android/os/Message.java b/src/java-framework/src/android/os/Message.java
index 1da52ec..ad36033 100644
--- a/src/java-framework/src/android/os/Message.java
+++ b/src/java-framework/src/android/os/Message.java
@@ -10,6 +10,21 @@ public final class Message {
     Message next;
     public Message() {}
     public static Message obtain() { return new Message(); }
+    /** Copy the payload and delivery target, as used by AppCompat dialog buttons. */
+    public static Message obtain(Message original) {
+        Message m = obtain();
+        m.what = original.what;
+        m.arg1 = original.arg1;
+        m.arg2 = original.arg2;
+        m.obj = original.obj;
+        m.replyTo = original.replyTo;
+        m.sendingUid = original.sendingUid;
+        m.workSourceUid = original.workSourceUid;
+        m.target = original.target;
+        m.callback = original.callback;
+        if (original.data != null) m.data = new Bundle(original.data);
+        return m;
+    }
     public static Message obtain(Handler h) { Message m = new Message(); m.target = h; return m; }
     public static Message obtain(Handler h, int what) { Message m = obtain(h); m.what = what; return m; }
     public static Message obtain(Handler h, int what, Object obj) { Message m = obtain(h, what); m.obj = obj; return m; }
@@ -33,7 +48,6 @@ public final class Message {
     public android.os.Messenger replyTo;
     public int sendingUid;
     public int workSourceUid;
-    public static android.os.Message obtain(android.os.Message p0) { return null; }
     public void copyFrom(android.os.Message p0) {}
     public int describeContents() { return 0; }
     public long getWhen() { return 0L; }
diff --git a/tests/java-framework/MessageCopyTest.java b/tests/java-framework/MessageCopyTest.java
new file mode 100644
index 0000000..6386e70
--- /dev/null
+++ b/tests/java-framework/MessageCopyTest.java
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+
+/** Host regression probe: no ART, native loop, device, or network is used. */
+public final class MessageCopyTest {
+    public static void main(String[] args) {
+        final int[] clicked = {0};
+        Handler handler = new Handler((Looper) null) {
+            @Override public void handleMessage(Message message) {
+                if (message.what == -1 && message.obj == clicked) clicked[0]++;
+            }
+        };
+        Message original = Message.obtain(handler, -1, 17, 23, clicked);
+        original.getData().putString("marker", "before");
+        original.sendingUid = 42;
+        original.workSourceUid = 43;
+        Runnable callback = new Runnable() { public void run() {} };
+        original.callback = callback;
+
+        Message copied = Message.obtain(original);
+        require(copied != null, "AppCompat button callback must not disappear");
+        require(copied != original, "Copy must be a distinct Message");
+        require(copied.target == handler, "Delivery target must survive");
+        require(copied.what == -1 && copied.arg1 == 17 && copied.arg2 == 23, "Integer payload must survive");
+        require(copied.obj == clicked && copied.callback == callback, "Object and callback must survive");
+        require(copied.sendingUid == 42 && copied.workSourceUid == 43, "Sender identity must survive");
+        copied.getData().putString("marker", "after");
+        require("before".equals(original.getData().getString("marker")), "Bundle must be copied");
+        require(copied.when == 0, "Copy must not inherit a queued delivery time");
+        copied.callback = null;
+        copied.target.dispatchMessage(copied);
+        require(clicked[0] == 1, "Copied dialog-style message must dispatch its action exactly once");
+        Message noData = Message.obtain(Message.obtain(handler, -2));
+        require(noData.getTarget() == handler && noData.what == -2, "Message without Bundle must copy");
+        System.out.println("PASS: Message.obtain preserves dialog delivery, payload, callback, and independent Bundle");
+    }
+
+    private static void require(boolean condition, String reason) {
+        if (!condition) throw new AssertionError(reason);
+    }
+}
